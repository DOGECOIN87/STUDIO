+  background:
+    linear-gradient(var(--border-strong), var(--border-strong)) 50% 50% / var(--range-tick, 0px) 100% no-repeat,
+    linear-gradient(90deg, transparent var(--fill-from, 0%), var(--range-color) var(--fill-from, 0%), var(--range-color) var(--fill-to, 0%), transparent var(--fill-to, 0%)),
+    var(--surface-0);
+  box-shadow: inset 0 0 0 1px var(--border), inset 0 1px 2px rgba(var(--shadow-rgb), calc(0.4 * var(--shadow-k)));
+}
+
+input[type="range"]:not(.mixer-v-fader)::-webkit-slider-thumb {
+  -webkit-appearance: none;
+  appearance: none;
+  width: var(--thumb);
+  height: var(--thumb);
+  margin-top: calc((var(--range-track) - var(--thumb)) / 2);
+  border-radius: 50%;
+  background: var(--range-thumb);
+  border: 2px solid var(--range-color);
+  box-shadow: var(--shadow-1);
+  transition: box-shadow var(--dur-fast) var(--ease-out);
+}
+
+input[type="range"]:not(.mixer-v-fader)::-moz-range-track {
+  height: var(--range-track);
+  border-radius: var(--r-pill);
+  background: var(--surface-0);
+  box-shadow: inset 0 0 0 1px var(--border-subtle);
+}
+
+input[type="range"]:not(.mixer-v-fader)::-moz-range-progress {
+  height: var(--range-track);
+  border-radius: var(--r-pill);
+  background: var(--range-color);
+}
+
+input[type="range"]:not(.mixer-v-fader)::-moz-range-thumb {
+  width: var(--thumb);
+  height: var(--thumb);
+  border-radius: 50%;
+  background: var(--range-thumb);
+  border: 2px solid var(--range-color);
+  box-shadow: var(--shadow-1);
+}
+
+@media (hover: hover) {
+  input[type="range"]:not(.mixer-v-fader):hover::-webkit-slider-thumb {
+    box-shadow: 0 0 0 4px rgba(var(--range-rgb), 0.25), var(--shadow-1);
+  }
+}
+
+input[type="range"]:not(.mixer-v-fader):active::-webkit-slider-thumb {
+  box-shadow: 0 0 0 6px rgba(var(--range-rgb), 0.25), var(--shadow-1);
+}
+
+input[type="range"]:not(.mixer-v-fader):focus,
+input[type="range"]:not(.mixer-v-fader):focus-visible {
+  outline: none;
+}
+
+input[type="range"]:not(.mixer-v-fader):focus-visible::-webkit-slider-thumb {
+  box-shadow: 0 0 0 2px var(--surface-0), 0 0 0 4px var(--focus);
+}
+
+/* S6  Popovers, dialogs, lists, cards, tooltip, toast ----------------------- */
+.popover,
+.topbar-menu-popover,
+.toolbar-overflow-content,
+.clip-context-menu {
+  background: var(--surface-popover);
+  border: 1px solid var(--hairline-strong);
+  border-radius: var(--r-panel);
+  box-shadow: var(--bevel), var(--shadow-3);
+}
+
+@media (max-width: 760px), (max-width: 900px) and (max-height: 520px) {
+  .toolbar-primary-menu[open] > .toolbar-primary-content,
+  .transport-extras[open] > .transport-extras-content,
+  .transport-readouts[open] > .transport-readouts-content {
+    background: var(--surface-popover);
+    border: 1px solid var(--hairline-strong);
+    border-radius: var(--r-panel);
+    /* a drop-shadow filter, not a box-shadow: the readouts sheet opens inside the transport rack */
+    filter: drop-shadow(0 6px 8px rgba(var(--shadow-rgb), calc(0.45 * var(--shadow-k))));
+  }
+}
+
+.ctx-head {
+  border-bottom: 1px solid var(--border-subtle);
+}
+
+.modal-backdrop {
+  background: rgba(var(--surface-0-rgb), 0.76);
+}
+
+.modal-card {
+  background: var(--surface-1);
+  border: 1px solid var(--hairline-strong);
+  border-radius: var(--r-dialog);
+  box-shadow: var(--shadow-3);
+}
+
+.modal-foot {
+  background: var(--surface-1);
+  border-top: 1px solid var(--border-subtle);
+}
+
+.export-status {
+  color: var(--text-secondary);
+}
+
+.saved-proj-row {
+  background: var(--surface-2);
+  border: 1px solid var(--hairline);
+  border-radius: var(--r-md);
+  box-shadow: var(--bevel);
+}
+
+@media (hover: hover) {
+  .saved-proj-row:hover {
+    background: var(--surface-hover);
+    border-color: var(--hairline-strong);
+  }
+}
+
+.asset-card {
+  background: var(--surface-2);
+  border: 1px solid var(--border-subtle);
+  border-radius: var(--r-md);
+  box-shadow: var(--bevel);
+}
+
+@media (hover: hover) {
+  .asset-card:hover {
+    border-color: var(--border-strong);
+  }
+}
+
+.asset-card.selected-stem {
+  background: var(--select-bg);
+  border-color: var(--lit);
+  box-shadow: var(--bevel), 0 0 0 1px var(--lit);
+}
+
+.fl-folder-item {
+  color: var(--text-secondary);
+  border-bottom: 1px solid var(--border-subtle);
+}
+
+@media (hover: hover) {
+  .fl-folder-item:hover {
+    background: var(--surface-hover);
+    color: var(--text-primary);
+  }
+}
+
+.fl-folder-item.active {
+  background: var(--select-bg);
+  color: var(--text-primary);
+  border-left: 0 solid transparent;
+  box-shadow: inset 0 0 0 1px rgba(var(--lit-rgb), 0.55);
+}
+
+.dropzone-box {
+  border: 1.5px dashed var(--border-strong);
+  background: rgba(var(--surface-0-rgb), 0.6);
+  border-radius: var(--r-md);
+  transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
+}
+
+.dropzone-box:hover,
+.dropzone-box.dragover {
+  border-color: var(--accent);
+  background: rgba(var(--accent-rgb), 0.08);
+}
+
+.track-header-item {
+  border-bottom-color: var(--border-subtle);
+}
+
+.track-header-item.selected {
+  background: var(--select-bg);
+}
+
+@media (hover: hover) {
+  .track-header-item:hover:not(.selected) {
+    background: rgba(var(--text-rgb), 0.04);
+  }
+}
+
+.panel-footer-tips {
+  background: var(--surface-1);
+  border-top-color: var(--border-subtle);
+  color: var(--text-secondary);
+}
+
+/* A selected row is an edge; only controls glow. */
+.cr-row.active-channel,
+.mixer-strip.selected,
+.fx-slot.active {
+  border-color: var(--lit);
+  box-shadow: inset 0 0 0 1px var(--lit);
+}
+
+.fx-slot {
+  background: var(--surface-0);
+  border-color: var(--border-subtle);
+}
+
+.tooltip {
+  position: fixed;
+  z-index: 300;
+  max-width: min(320px, calc(100vw - 16px));
+  padding: 6px 10px;
+  background: var(--surface-popover);
+  color: var(--text-primary);
+  border: 1px solid var(--hairline-strong);
+  border-radius: var(--r-sm);
+  box-shadow: var(--shadow-2);
+  font-weight: 500;
+  line-height: 1.35;
+  pointer-events: none;
+  white-space: normal;
+  animation: ds-tip-in var(--dur-fast) var(--ease-out);
+}
+
+.toast {
+  display: none;
+}
+
+@media (max-width: 760px), (max-width: 900px) and (max-height: 520px) {
+  .toast {
+    position: fixed;
+    z-index: 250;
+    left: 8px;
+    right: 8px;
+    bottom: 52px;
+    bottom: calc(52px + env(safe-area-inset-bottom));
+    margin-left: auto;
+    margin-right: auto;
+    max-width: 480px;
+    display: flex;
+    align-items: center;
+    gap: var(--space-md);
+    min-height: 44px;
+    padding: 10px 14px;
+    background: var(--surface-popover);
+    color: var(--text-primary);
+    border: 1px solid var(--hairline-strong);
+    border-radius: var(--r-panel);
+    box-shadow: var(--bevel), var(--shadow-3);
+    font-weight: 500;
+    line-height: 1.35;
+    pointer-events: none;
+    animation: ds-toast-in var(--dur-base) var(--ease-out);
+  }
+
+  .toast[data-kind="error"] {
+    border-color: rgba(var(--danger-rgb), 0.55);
+  }
+
+  .toast[data-kind="error"]::before {
+    content: "";
+    flex: 0 0 auto;
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
+    background: var(--danger);
+  }
+}
+
+@media (pointer: coarse), (hover: none) {
+  .tooltip {
+    display: none;
+  }
+}
+
+/* S7  Meters, LEDs, steps, pads --------------------------------------------- */
+.meter-bar,
+.track-meter-mini,
+.mixer-v-meter {
+  background-color: var(--meter-trough);
+  background-image: var(--well-shade);
+  border-radius: var(--r-xs);
+}
+
+.meter-bar,
+.mixer-v-meter {
+  border: 1px solid var(--border-subtle);
+}
+
+.meter-fill,
+.track-meter-fill {
+  background: linear-gradient(90deg, var(--meter-ok) 0%, var(--meter-ok) 62%, var(--meter-warn) 82%, var(--meter-clip) 100%);
+  transition: none;
+}
+
+.mixer-v-meter-fill {
+  background: linear-gradient(0deg, var(--meter-ok) 0%, var(--meter-ok) 62%, var(--meter-warn) 82%, var(--meter-clip) 100%);
+  transition: none;
+}
+
+.cr-led,
+.fx-led {
+  background: var(--surface-0);
+  border: 1px solid var(--border);
+}
+
+.cr-led.on,
+.fx-led.on {
+  background: var(--led-on);
+  border-color: rgba(255, 255, 255, 0.4);
+  box-shadow: 0 1px 6px -1px rgba(var(--accent-rgb), 0.8);
+}
+
+.cr-step {
+  border: 1px solid rgba(var(--shadow-rgb), 0.65);
+  border-radius: var(--r-xs);
+}
+
+.cr-step.active {
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 55%, rgba(var(--shadow-rgb), 0.38) 100%), var(--accent);
+  border-color: rgba(255, 255, 255, 0.55);
+  box-shadow: 0 1px 8px -2px rgba(var(--accent-rgb), 0.75);
+}
+
+.cr-step.playing-step {
+  outline: 2px solid var(--info);
+}
+
+/* Pad primitive: a tap target with a label and a meta line. Pads are pads:
+   never waveforms, never mute/solo chips, never clip-style content. */
+.matrix-pad {
+  background: var(--surface-2);
+  border: 1.5px solid var(--pad-color, var(--border));
+  border-radius: var(--r-ctl);
+  box-shadow: var(--bevel), var(--shadow-1);
+  transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), transform var(--dur-press) var(--ease-out);
+}
+
+.matrix-pad.triggered {
+  border-color: var(--pad-color, var(--accent));
+  box-shadow: var(--bevel), 0 0 0 1px var(--pad-color, var(--accent)), inset 0 0 0 1px rgba(255, 255, 255, 0.3), 0 2px 14px -2px rgba(var(--pad-rgb, var(--accent-rgb)), 0.75);
+  transform: scale(0.97);
+}
+
+/* S8  Wallpaper: painted behind the arrangement only; panes stay solid ------ */
+body[data-wallpaper]:not([data-wallpaper="none"]) #app-shell {
+  background: var(--surface-0) var(--audius-wallpaper-url) center / cover no-repeat;
+}
+
+body[data-wallpaper]:not([data-wallpaper="none"]) .workspace,
+body[data-wallpaper]:not([data-wallpaper="none"]) .playlist-center,
+body[data-wallpaper]:not([data-wallpaper="none"]) .playlist-body,
+body[data-wallpaper]:not([data-wallpaper="none"]) .timeline-viewport {
+  background: transparent;
+}
+
+/* S9  Motion ------------------------------------------------------------------ */
+@keyframes ds-pop-in {
+  from {
+    opacity: 0;
+    transform: translateY(-4px) scale(0.98);
+  }
+}
+
+@keyframes ds-sheet-in {
+  from {
+    opacity: 0;
+    transform: translateY(14px);
+  }
+}
+
+@keyframes ds-tip-in {
+  from {
+    opacity: 0;
+    transform: translateY(2px);
+  }
+}
+
+@keyframes ds-toast-in {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+}
+
+@keyframes ds-fade-in {
+  from {
+    opacity: 0;
+  }
+}
+
+.topbar-menu[open] > .topbar-menu-popover,
+.toolbar-overflow-menu[open] > .toolbar-overflow-content,
+.clip-context-menu:not([hidden]) {
+  animation: ds-pop-in var(--dur-base) var(--ease-out);
+  transform-origin: top right;
+}
+
+@media (max-width: 760px), (max-width: 900px) and (max-height: 520px) {
+  .transport-extras[open] > .transport-extras-content,
+  .transport-readouts[open] > .transport-readouts-content,
+  .toolbar-primary-menu[open] > .toolbar-primary-content,
+  .toolbar-overflow-menu[open] > .toolbar-overflow-content {
+    animation: ds-sheet-in var(--dur-slow) var(--ease-out);
+  }
+}
+
+/* Reduced motion keeps feedback and drops movement: colour transitions stay,
+   every entrance becomes a short opacity fade, press and pad scale stop. */
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto;
+  }
+
+  :root,
+  body {
+    --press-t: none;
+  }
+
+  .matrix-pad.triggered {
+    transform: none;
+  }
+
+  input[type="checkbox"]::after {
+    transform: none;
+    opacity: 0;
+    transition: opacity var(--dur-fast) linear;
+  }
+
+  input[type="checkbox"]:checked::after {
+    opacity: 1;
+  }
+
+  input[type="checkbox"].switch::after {
+    transition: background-color var(--dur-fast) linear;
+  }
+
+  .topbar-menu[open] > .topbar-menu-popover,
+  .toolbar-overflow-menu[open] > .toolbar-overflow-content,
+  .clip-context-menu:not([hidden]),
+  .transport-extras[open] > .transport-extras-content,
+  .transport-readouts[open] > .transport-readouts-content,
+  .toolbar-primary-menu[open] > .toolbar-primary-content,
+  .tooltip,
+  .toast {
+    animation: ds-fade-in var(--dur-fast) linear;
+  }
+}
