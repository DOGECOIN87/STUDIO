+/* ============================================================================
+   ROLE CONTRACT (design foundation)
+   Every theme above maps onto these roles. Components read roles, never raw
+   palette variables or literal colours. Derived roles use var() only; opaque
+   blends are precomputed per theme and alpha tints use the --*-rgb triplets,
+   so nothing here needs a colour-mixing function or other newer colour syntax.
+   Declared on :root and body because the custom accent / background pickers
+   set the legacy palette variables inline on body.
+   ============================================================================ */
+:root,
+body {
+  /* surfaces: wells and canvas, panes, bars and title bars, raised controls, popovers */
+  --surface-0: var(--bg-darkest);
+  --surface-1: var(--bg-panel);
+  --surface-2: var(--bg-header);
+  --surface-3: var(--bg-control);
+  --surface-popover: var(--bg-panel-alt);
+  --surface-hover: var(--bg-hover);
+  --surface-press: var(--bg-header);
+  --select-bg: var(--bg-selected);
+
+  /* lines (--border-subtle and --border-strong are precomputed in each theme block) */
+  --border: var(--border-color);
+  --hairline: rgba(var(--text-rgb), 0.1);
+  --hairline-strong: rgba(var(--text-rgb), 0.16);
+
+  /* text */
+  --text-primary: var(--text-main);
+  --text-secondary: var(--text-muted);
+  --on-accent: var(--accent-on-primary);
+
+  /* Audius accent and brand */
+  --accent: var(--accent-orange);
+  --accent-fill: var(--accent-orange);
+  --accent-text: var(--accent-orange-bright);
+  --accent-gradient: var(--audius-gradient);
+  --brand-gradient: var(--audius-gradient);
+  --brand-stripe: linear-gradient(90deg, var(--accent) 0%, var(--lit) 100%);
+  --play-gradient: var(--accent-gradient);
+  --play-glow: var(--accent);
+
+  /* lit (selected / on), info (time) and focus */
+  --lit: var(--accent-teal);
+  --info: var(--accent-teal);
+  --lcd-text: var(--info);
+  --focus: var(--text-main);
+  --glow-a: 0.6;
+
+  /* channel states and danger */
