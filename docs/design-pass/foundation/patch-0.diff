+/* ============================================================================
+   DESIGN SYSTEM LAYER ("Elevated Audius": the lit rack)
+   Last block of the file on purpose. Everything above this comment owns
+   geometry (display, position, size, spacing, overflow, responsive show/hide);
+   this block owns skin: colour, border colour and style, radius, shadow,
+   outline, type, motion, cursor and opacity. It comes last so it wins at equal
+   specificity without cascade layers (older browsers drop a layered block
+   whole), and it carries no !important. It sets geometry only on its own classes
+   (.btn*, .rack, .lcd*, .segmented, .stepper, .tooltip, .toast, .empty-state,
+   .visually-hidden) and on the few listed exceptions (pat/song padding, range
+   and checkbox sizes, close-button spacing). Read DESIGN.md before editing.
+   ============================================================================ */
+
+/* S1  Base and browser surfaces ------------------------------------------- */
+html,
+body {
+  background: var(--surface-0);
+  color: var(--text-primary);
+  font-family: var(--font-ui);
+  font-size: var(--fs-label);
+  line-height: var(--lh-label);
+  letter-spacing: var(--track-ui);
+  font-feature-settings: "kern" 1;
+  caret-color: var(--accent);
+}
+
+:where(body *) {
+  font-size: var(--fs-label);
+  letter-spacing: inherit;
+}
+
+:where(button, input, select, textarea, summary) {
+  font-family: inherit;
+}
+
+::selection {
+  background: rgba(var(--accent-rgb), 0.38);
+  color: var(--text-primary);
+}
+
+* {
+  scrollbar-width: thin;
+  scrollbar-color: var(--border-strong) transparent;
+}
+
+*:hover {
+  scrollbar-color: var(--text-secondary) transparent;
+}
+
+::-webkit-scrollbar {
+  width: 10px;
+  height: 10px;
+}
+
+::-webkit-scrollbar-track,
+::-webkit-scrollbar-corner {
+  background: transparent;
+}
+
+::-webkit-scrollbar-thumb {
+  background-color: var(--border-strong);
+  background-clip: content-box;
+  border: 2px solid transparent;
+  border-radius: var(--r-pill);
+}
+
+::-webkit-scrollbar-thumb:hover {
+  background-color: var(--text-secondary);
+}
+
+/* Focus: a 2px ring in the text colour, never the lit or selection colour.
+   The plain :focus rule first keeps a ring in Safari 14-15 (no :focus-visible);
+   browsers that know :focus-visible then drop it for pointer focus. */
+:focus {
+  outline: 2px solid var(--focus);
+  outline-offset: 2px;
+}
+
+:focus:not(:focus-visible) {
+  outline: none;
+}
+
+:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 2px;
+}
+
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline-offset: 1px;
+}
+
+.trk-btn:focus-visible,
+.cr-step:focus-visible,
+.fx-slot:focus-visible,
+.fl-folder-item:focus-visible,
+.asset-card:focus-visible,
+.matrix-pad:focus-visible {
+  outline-offset: -2px;
+}
+
+option {
+  background: var(--surface-popover);
+  color: var(--text-primary);
+}
+
+/* The app disables text selection on its chrome; fields must stay selectable and typeable. */
+input,
+textarea,
+select,
+[contenteditable] {
+  -webkit-user-select: text;
+  user-select: text;
+}
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  margin: -1px;
+  padding: 0;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* S2  Type roles ------------------------------------------------------------
+   15px floor (kbd is the one exempt chip). Weights used: 400, 500, 600, 700. */
+.title,
+.fl-win-title,
+.panel-header > span,
+.audius-panel-heading,
+#touch-counter-badge {
+  font-size: var(--fs-title);
+  font-weight: 600;
+  line-height: var(--lh-tight);
+  color: var(--text-primary);
+  text-transform: none;
+}
+
+.fl-win-title strong,
+#fx-track-name,
+.title-context {
+  font-size: var(--fs-label);
+  font-weight: 500;
+  color: var(--text-secondary);
+  text-transform: none;
+  letter-spacing: var(--track-ui);
+}
+
+.fl-win-title .icon,
+.panel-header .icon,
+.audius-panel-heading .icon,
+.fl-window-header .icon {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+  color: var(--text-secondary);
+}
+
+.section-title,
+.trellis-title,
+.sub-header,
+.fx-rack-head,
+.tip-title,
+.cluster-label,
+.palette-lbl,
+.ctx-head > span:first-child,
+.track-column-top > span {
+  font-size: var(--fs-section);
+  font-weight: 700;
+  line-height: var(--lh-tight);
+  text-transform: uppercase;
+  letter-spacing: var(--track-section);
+  color: var(--text-primary);
+}
+
+.section-title .icon,
+.trellis-title .icon,
+.tip-title .icon {
+  width: var(--icon-md);
+  height: var(--icon-md);
+  color: var(--accent-text);
+}
+
+.modal-head h3 {
+  font-size: var(--fs-heading);
+  font-weight: 600;
+  line-height: 1.25;
+  letter-spacing: -0.01em;
+  color: var(--text-primary);
+}
+
+.modal-head h3 .icon {
+  width: var(--icon-lg);
+  height: var(--icon-lg);
+  color: var(--text-secondary);
+}
+
+.modal-body,
+.modal-hint,
+.inspector-empty {
+  font-size: var(--fs-body);
+  line-height: var(--lh-body);
+}
+
+.modal-hint,
+.inspector-empty,
+.empty-state {
+  color: var(--text-secondary);
+}
+
+.empty-state {
+  line-height: var(--lh-body);
+  text-align: center;
+  padding: var(--space-xl) var(--space-lg);
+}
+
+.field-row label,
+.field-box label,
+.slider-head label,
+.checkbox-label span,
+.fl-swing-wrap span,
+.zoom-control {
+  font-weight: 500;
+  color: var(--text-secondary);
+}
+
+.stamp-toggle {
+  color: var(--text-primary);
+  font-weight: 600;
+}
+
+/* Numeric read-outs: Avenir tabular figures, never monospace. */
+.readout-main {
+  font: 600 var(--fs-readout-lg) / 1 var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+  letter-spacing: 0;
+  color: var(--lcd-text);
+}
+
+.readout-sub {
+  font: 500 var(--fs-readout-sm) / 1.2 var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+  letter-spacing: 0;
+  color: var(--text-secondary);
+}
+
+#bpm-input {
+  font: 600 var(--fs-readout-md) / 1 var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+  letter-spacing: 0;
+  color: var(--lcd-text);
+}
+
+.bpm-decimals {
+  font: 500 var(--fs-label) / 1 var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+  color: var(--text-secondary);
+  opacity: 1;
+}
+
+.cursor-info,
+.mixer-db-lbl,
+.slider-head span,
+.cr-insert-box,
+.mixer-strip-num,
+.saved-proj-meta,
+.asset-meta {
+  font-family: var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+}
+
+.cursor-info,
+.status-pill,
+.asset-meta {
+  color: var(--text-secondary);
+  font-weight: 500;
+}
+
+.slider-head span {
+  color: var(--text-primary);
+  font-weight: 600;
+}
+
+.mixer-db-lbl {
+  color: var(--lcd-text);
+}
+
+.cr-insert-box,
+.selected-clip-badge {
+  color: var(--text-secondary);
+}
+
+.track-insp-title {
+  color: var(--text-primary);
+  font-weight: 600;
+}
+
+.fl-menu-item {
+  font-weight: 600;
+  color: var(--text-secondary);
+  border-radius: var(--r-xs);
+  cursor: pointer;
+  transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
+}
+
+.track-title,
+.asset-name,
+.dropzone-title,
+.minimap-label,
+.cr-channel-btn,
+.mixer-strip-name,
+.mixer-strip-num,
+.project-name-input,
+.project-name-label,
+.matrix-pad-name {
+  font-weight: 600;
+}
+
+.fl-folder-item,
+.status-pill,
+.dropzone-sub,
+.matrix-pad-meta {
+  font-weight: 500;
+}
+
+kbd {
+  font: 600 var(--fs-kbd) / 1 var(--font-ui);
+  letter-spacing: 0;
+  color: var(--text-secondary);
+  background: rgba(var(--text-rgb), 0.09);
+  border: 1px solid var(--hairline);
+  border-radius: var(--r-xs);
+  padding: 2px 5px;
+}
+
+.icon {
+  stroke-width: 2;
+}
+
+.btn .icon,
+.tool-btn .icon,
+.mini-btn .icon,
+.action-btn .icon,
+.nudge-btn .icon,
+.ctx-btn .icon,
+.topbar-menu > summary .icon,
+.toolbar-primary-menu > summary .icon,
+.toolbar-overflow-menu > summary .icon {
+  width: var(--icon-md);
+  height: var(--icon-md);
+}
+
+.btn--sm .icon,
+.btn--xs .icon,
+.tiny-btn .icon,
+.asset-actions button .icon,
+.panel-close-btn .icon,
+.icon-close .icon,
+.bpm-step-btn .icon,
+.reopen-pool-btn .icon,
+.trk-btn .icon {
+  width: var(--icon-sm);
+  height: var(--icon-sm);
+}
+
+.transport-btn.play .icon,
+.btn--play .icon,
+.mobile-window-switcher button .icon {
+  width: var(--icon-lg);
+  height: var(--icon-lg);
+}
+
+/* S3  Bars, panes, title bars, racks, wells ------------------------------- */
+.topbar {
+  background: var(--brand-stripe) top left / 100% 2px no-repeat border-box, linear-gradient(var(--surface-1), var(--surface-1)) padding-box;
+  border-image: none;
+  border-top: 2px solid transparent;
+  border-bottom: 1px solid var(--border-subtle);
+}
+
+.toolbar {
+  background: var(--surface-1);
+  border-bottom: 1px solid var(--border-subtle);
+}
+
+.workspace,
+.playlist-center,
+.timeline-viewport {
+  background: var(--surface-0);
+}
+
+.left-panel,
+.right-panel,
+.fl-subwindow,
+.trellis-dock,
+.mixer-window,
+.track-column,
+.fl-upper-dock,
+.mixer-fx-rack {
+  background-color: var(--surface-1);
+  border-color: var(--border);
+}
+
+.fl-upper-dock,
+.channel-rack-window,
+.mixer-window,
+.mixer-fx-rack {
+  border-width: 1px;
+}
+
+.playlist-bottombar {
+  background: var(--surface-1);
+  border-top: 1px solid var(--border-subtle);
+  color: var(--text-secondary);
+}
+
+.titlebar,
+.panel-header,
+.fl-window-header,
+.track-column-top,
+.minimap-bar,
+.modal-head {
+  background: var(--surface-2);
+  color: var(--text-primary);
+  border-bottom: 1px solid var(--border-subtle);
+  box-shadow: var(--bevel);
+}
+
+/* a dialog header sits inside the dialog card, so it takes no bevel of its own */
+.modal-head {
+  box-shadow: none;
+}
+
+.minimap-label {
+  border-right-color: var(--border-subtle);
+}
+
+.fl-win-controls > .panel-close-btn,
+.fl-win-controls > .icon-close,
+.trellis-dock-head .panel-header-actions > .panel-close-btn,
+.trellis-dock-head .panel-header-actions > .icon-close,
+.titlebar__actions > .panel-close-btn,
+.titlebar__actions > .icon-close {
+  position: relative;
+  margin-inline-start: var(--space-xs);
+}
+
+.fl-win-controls > .panel-close-btn::before,
+.fl-win-controls > .icon-close::before,
+.trellis-dock-head .panel-header-actions > .panel-close-btn::before,
+.trellis-dock-head .panel-header-actions > .icon-close::before,
+.titlebar__actions > .panel-close-btn::before,
+.titlebar__actions > .icon-close::before {
+  content: "";
+  position: absolute;
+  top: 5px;
+  bottom: 5px;
+  left: calc(-1 * var(--space-xs) - 1px);
+  width: 1px;
+  background: var(--border-subtle);
+}
+
+.rack,
+.transport-group,
+.audius-logo-lockup {
+  background: var(--surface-2);
+  border: 1px solid var(--hairline);
+  border-radius: var(--r-panel);
+  box-shadow: var(--bevel), var(--shadow-2);
+  animation: none;
+}
+
+.rack {
+  padding: var(--space-sm);
+  display: flex;
+  align-items: center;
+  gap: var(--space-sm);
+}
+
+.audius-logo-lockup,
+.audius-horizontal-svg {
+  color: var(--logo-ink);
+}
+
+.audius-lockup-glyph {
+  animation: none;
+}
+
+@media (hover: hover) {
+  .audius-logo-lockup:hover {
+    border-color: var(--hairline-strong);
+    box-shadow: var(--bevel), var(--shadow-2);
+    transform: none;
+  }
+}
+
+/* Wells are recesses: no border, no box-shadow, never a nested card. The recess is a shade
+   painted as a background layer (--well-shade) so a well inside a rack stays flat to the eye
+   and to the checks that count shadowed boxes as cards. */
+.lcd,
+.time-readout,
+.bpm-box,
+.osc-canvas {
+  background-color: var(--surface-0);
+  background-image: var(--well-shade);
+  border: 0;
+  border-radius: var(--r-ctl);
+}
+
+.lcd {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-sm);
+  min-height: var(--ctl-h);
+  padding: 0 var(--space-md);
+}
+
+.lcd__value {
+  font: 600 var(--fs-readout-md) / 1 var(--font-num);
+  font-variant-numeric: tabular-nums lining-nums;
+  letter-spacing: 0;
+  color: var(--lcd-text);
+}
+
+.lcd__value--lg {
+  font-size: var(--fs-readout-lg);
+}
+
+.lcd__unit {
+  color: var(--text-secondary);
+  font-weight: 500;
+}
+
+.fl-hint-bar,
+.fl-pattern-selector,
+.palette-bar {
+  background: transparent;
+  border: 1px solid transparent;
+  box-shadow: none;
+}
+
+/* S4  Buttons: one family, the owner's raised-button language --------------
+   Secondary is the default skin of every legacy button class. */
+.btn,
+.tool-btn,
+.mini-btn,
+.tiny-btn,
+.action-btn,
+.transport-btn,
+.nudge-btn,
+.ctx-btn,
+.bpm-step-btn,
+.reopen-pool-btn,
+.asset-actions button,
+.custom-color-chip,
