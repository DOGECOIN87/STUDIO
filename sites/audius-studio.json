  {
   "name": "chopClips",
   "description": "Chop the selected clips (or clipIds) into uniform segments by preset, or by detected transients.",
   "request": {
    "method": "POST",
    "url": "http://127.0.0.1:3000/api/call",
    "headers": {
     "content-type": "application/json",
     "accept": "application/json"
    },
    "body": "{\"site\":\"audius-studio\",\"op\":\"chopClips\",\"args\":{\"clipIds\":[],\"preset\":\"1bar\",\"transients\":false}}"
   },
   "slots": [
    {
     "param": "clipIds",
     "at": [
      "body",
      "json:/args/clipIds"
     ]
    },
    {
     "param": "preset",
     "at": [
      "body",
      "json:/args/preset"
     ]
    },
    {
     "param": "transients",
     "at": [
      "body",
      "json:/args/transients"
     ]
    }
   ],
   "volatile": [],
   "trigger": {
    "url": "http://127.0.0.1:3000/"
   },
   "match": {
    "method": "POST",
    "path": "/api/call"
   },
   "response": {
    "format": "json",
    "contentType": "application/json; charset=utf-8",
    "extract": "data"
   },
   "params": [
    {
     "name": "clipIds",
     "type": "array",
     "required": false,
     "description": "Clip ids to chop; omit for the current playlist selection."
    },
    {
     "name": "preset",
     "type": "string",
     "required": false,
     "description": "Uniform grid: 1beat, 1bar, halfbar or eighth.",
     "pattern": "^(1beat|1bar|halfbar|eighth)$",
     "hint": "one of 1beat, 1bar, halfbar, eighth"
    },
    {
     "name": "transients",
     "type": "boolean",
     "required": false,
     "description": "true = Auto-Slice Hits by detected transients instead of the grid."
    }
   ],
   "readOnly": false,
   "minTier": 1,
   "learnedLoggedIn": false,
   "learnedAt": "2026-10-20T00:00:00.000Z"
  },
  {
   "name": "exportWav",
   "description": "Render the arrangement offline to WAV (faster than realtime) and store it on the server; returns files with name, url, bytes, durationSec. mode=stems renders one file per unmuted track.",
   "request": {
    "method": "POST",
    "url": "http://127.0.0.1:3000/api/call",
    "headers": {
     "content-type": "application/json",
     "accept": "application/json"
    },
    "body": "{\"site\":\"audius-studio\",\"op\":\"exportWav\",\"args\":{\"mode\":\"master\",\"bitDepth\":24,\"sampleRate\":44100,\"range\":\"song\"}}"
   },
   "slots": [
    {
     "param": "mode",
     "at": [
      "body",
      "json:/args/mode"
     ]
    },
    {
     "param": "bitDepth",
     "at": [
      "body",
      "json:/args/bitDepth"
     ]
    },
    {
     "param": "sampleRate",
     "at": [
      "body",
      "json:/args/sampleRate"
     ]
    },
    {
     "param": "range",
     "at": [
      "body",
      "json:/args/range"
     ]
    }
   ],
   "volatile": [],
   "trigger": {
    "url": "http://127.0.0.1:3000/"
   },
   "match": {
    "method": "POST",
    "path": "/api/call"
   },
   "response": {
    "format": "json",
    "contentType": "application/json; charset=utf-8",
    "extract": "data"
   },
   "params": [
    {
     "name": "mode",
     "type": "string",
     "required": false,
     "description": "master (stereo mixdown) or stems (one file per track).",
     "pattern": "^(master|stems)$",
     "hint": "master or stems"
    },
    {
     "name": "bitDepth",
     "type": "number",
     "required": false,
     "description": "16, 24 or 32-bit WAV.",
     "pattern": "^(16|24|32)$",
     "hint": "16, 24 or 32"
    },
    {
     "name": "sampleRate",
     "type": "number",
     "required": false,
     "description": "44100 or 48000 Hz.",
     "pattern": "^(44100|48000)$",
     "hint": "44100 or 48000"
    },
    {
     "name": "range",
     "type": "string",
     "required": false,
     "description": "song (full arrangement) or loop (the loop region).",
     "pattern": "^(song|loop)$",
     "hint": "song or loop"
    }
   ],
   "readOnly": false,
   "minTier": 1,
   "learnedLoggedIn": false,
   "learnedAt": "2026-10-20T00:00:00.000Z"
  }
 ]
