{
  "name": "audius-studio",
  "version": "1.0.0",
  "description": "STUDIO (audius-studio.online) \u2014 Music Done Right. Ubuntu & Web $AUDIO Workstation (import/export WAV/MP3/FLAC/OGG, razor slice, chop, rearrange, per-track EQ & stems) \u2014 fully functional via an api-anything style HTTP API, CLI and MCP server",
  "type": "module",
  "scripts": {
    "start": "node app/server.mjs",
    "dev": "node app/server.mjs",
    "test:api": "node test/api/smoke.mjs",
    "mcp": "node app/api/mcp.mjs",
    "mcp:writes": "node app/api/mcp.mjs --allow-writes",
    "daw-api": "node tools/daw-api/daw-api.mjs",
    "build:wasm": "node tools/wasm-plugins/build.mjs",
    "test:smoke": "node tools/smoke.mjs",
    "test:browser": "node tools/browser/layout-audit.mjs",
    "test:wasm": "node tools/test-wasm-fx.mjs",
    "test:mammoth": "node tools/test-mammoth.mjs",
    "test:synth-browser": "node tools/browser/synth-audit.mjs"
  },
  "devDependencies": {
    "css-tree": "^3.2.1",
    "playwright": "^1.64.1",
    "wabt": "^1.0.39"
  }
}
